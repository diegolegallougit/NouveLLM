generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  name          String?
  password      String?
  role          Role           @default(EC)
  onboarded     Boolean        @default(false)
  externalId    String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  groups        UserGroup[]
}

enum Role {
  STUDENT
  EC
  ADMIN
}

model Group {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  label                String
  type                 String        @default("SYSTEME")
  quotaTokens          Int           @default(500000)
  allowPersonalSources Boolean       @default(false)
  systemPromptExtra    String?
  users                UserGroup[]
  allowedAgents        GroupAgent[]
  allowedSources       GroupSource[]
}

model UserGroup {
  userId  String
  groupId String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Agent {
  id          String       @id @default(cuid())
  slug        String       @unique
  label       String
  icon        String
  description String
  difyAppId   String
  difyApiKey  String
  status      AgentStatus  @default(ACTIVE)
  groups      GroupAgent[]
}

enum AgentStatus {
  ACTIVE
  BETA
  DISABLED
}

model GroupAgent {
  groupId String
  agentId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([groupId, agentId])
}

model Source {
  id            String        @id @default(cuid())
  slug          String        @unique
  label         String
  icon          String
  description   String
  difyDatasetId String
  docCount      Int?
  access        SourceAccess  @default(PUBLIC)
  groups        GroupSource[]
}

enum SourceAccess {
  PUBLIC
  RESTRICTED
}

model GroupSource {
  groupId  String
  sourceId String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([groupId, sourceId])
}

model Conversation {
  id         String    @id @default(cuid())
  userId     String
  title      String?
  agentSlug  String?
  difyConvId String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  agentUsed      String?
  sources        String?
  tokenCount     Int?
  feedback       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  USER
  ASSISTANT
}
