generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// TODO: changer provider "sqlite" → "postgresql" et ajouter url = env("DATABASE_URL") pour la prod
// Voir scripts/migrate-to-postgres.md
datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String                     @id @default(cuid())
  email               String                     @unique
  emailVerified       DateTime?
  name                String?
  password            String?
  role                Role                       @default(EC)
  onboarded           Boolean                    @default(false)
  externalId          String?
  deletedAt           DateTime?
  createdAt           DateTime                   @default(now())
  accounts            Account[]
  sessions            Session[]
  conversations       Conversation[]
  groups              UserGroup[]
  courseSessions      CourseSession[]
  sessionParticipants CourseSessionParticipant[]
  surveyResponses     SurveyResponse[]
  hilRequests         HILRequest[]
  ownedSpaces         DocumentSpace[]      @relation("OwnedSpaces")
  uploadedDocuments   SpaceDocument[]      @relation("UploadedDocuments")
  authoredMetaPrompts MetaPrompt[]         @relation("AuthoredMetaPrompts")
  activeMetaPrompts   UserActiveMetaPrompt[]
}

enum Role {
  STUDENT
  EC
  ADMIN
}

model Group {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  label                String
  type                 String        @default("SYSTEME")
  quotaTokens          Int           @default(500000)
  allowPersonalSources Boolean       @default(false)
  systemPromptExtra    String?
  users                UserGroup[]
  allowedAgents        GroupAgent[]
  allowedSources       GroupSource[]
  surveys              Survey[]
}

model UserGroup {
  userId  String
  groupId String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Agent {
  id              String               @id @default(cuid())
  slug            String               @unique
  label           String
  icon            String
  description     String
  difyAppId       String
  difyApiKey      String
  status          AgentStatus          @default(ACTIVE)
  groups          GroupAgent[]
  sessionAgents   CourseSessionAgent[]
}

enum AgentStatus {
  ACTIVE
  BETA
  DISABLED
}

model GroupAgent {
  groupId String
  agentId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([groupId, agentId])
}

model Source {
  id              String                @id @default(cuid())
  slug            String                @unique
  label           String
  icon            String
  description     String
  difyDatasetId   String
  docCount        Int?
  access          SourceAccess          @default(PUBLIC)
  groups          GroupSource[]
  sessionSources  CourseSessionSource[]
}

enum SourceAccess {
  PUBLIC
  RESTRICTED
}

model GroupSource {
  groupId  String
  sourceId String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([groupId, sourceId])
}

model Conversation {
  id             String         @id @default(cuid())
  userId         String
  title          String?
  agentSlug      String?
  difyConvId     String?
  courseSessionId String?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseSession  CourseSession? @relation(fields: [courseSessionId], references: [id])
  messages       Message[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  agentUsed      String?
  sources        String?
  tokenCount     Int?
  feedback       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  USER
  ASSISTANT
}

model CourseSession {
  id              String                     @id @default(cuid())
  code            String                     @unique
  name            String
  description     String?
  systemPrompt    String?
  validUntil      DateTime
  maxParticipants Int?
  access          SessionAccess              @default(OPEN)
  status          SessionStatus              @default(ACTIVE)
  ecUserId        String
  ec              User                       @relation(fields: [ecUserId], references: [id], onDelete: Cascade)
  agents          CourseSessionAgent[]
  sources         CourseSessionSource[]
  participants    CourseSessionParticipant[]
  conversations   Conversation[]
  createdAt       DateTime                   @default(now())
}

enum SessionAccess {
  OPEN
  CLOSED
}

enum SessionStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model CourseSessionAgent {
  sessionId String
  agentId   String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([sessionId, agentId])
}

model CourseSessionSource {
  sessionId String
  sourceId  String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  source    Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sessionId, sourceId])
}

model CourseSessionParticipant {
  sessionId String
  userId    String
  joinedAt  DateTime      @default(now())
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
}

model Survey {
  id          String           @id @default(cuid())
  title       String
  groupId     String?
  group       Group?           @relation(fields: [groupId], references: [id])
  tokenReward Int              @default(500)
  active      Boolean          @default(true)
  questions   SurveyQuestion[]
  responses   SurveyResponse[]
  createdAt   DateTime         @default(now())
}

model SurveyQuestion {
  id       String @id @default(cuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  order    Int
  text     String
  options  String
  correct  Int?
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  userId      String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     String
  score       Int?
  tokenEarned Int?
  createdAt   DateTime @default(now())

  @@unique([surveyId, userId])
}

// ─── Routing intelligent ──────────────────────────────────────────────────────

model RoutingFamily {
  id          String            @id @default(cuid())
  slug        String            @unique
  label       String
  icon        String
  description String
  order       Int               @default(0)
  active      Boolean           @default(true)
  questions   RoutingQuestion[]
  createdAt   DateTime          @default(now())
}

model RoutingQuestion {
  id       String          @id @default(cuid())
  familyId String
  family   RoutingFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  question String
  order    Int             @default(0)
  options  RoutingOption[]
}

model RoutingOption {
  id             String          @id @default(cuid())
  questionId     String
  question       RoutingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label          String
  agentSlug      String?
  nextQuestionId String?
  order          Int             @default(0)
  comingSoon     Boolean         @default(false)
}

// ─── Human in the Loop ───────────────────────────────────────────────────────

model ExpertContact {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  role         String
  description  String
  scope        String
  contactEmail String
  calendarUrl  String?
  tchapId      String?
  active       Boolean      @default(true)
  requests     HILRequest[]
}

model HILRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertContactId String
  expert          ExpertContact @relation(fields: [expertContactId], references: [id])
  contextSummary  String
  userMessage     String
  conversationId  String?
  status          HILStatus     @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum HILStatus {
  PENDING
  SENT
  COMPLETED
}

// ─── Méta-prompts ────────────────────────────────────────────────────────────

enum MetaPromptLevel {
  INSTITUTIONAL
  SHARED
  PERSONAL
}

model MetaPrompt {
  id            String               @id @default(cuid())
  title         String
  description   String?
  content       String
  level         MetaPromptLevel
  authorId      String?
  author        User?                @relation("AuthoredMetaPrompts", fields: [authorId], references: [id])
  isPublic      Boolean              @default(false)
  allowedGroups String               @default("[]")
  uses          Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  activeFor     UserActiveMetaPrompt[]
}

model UserActiveMetaPrompt {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaPromptId String
  metaPrompt   MetaPrompt @relation(fields: [metaPromptId], references: [id], onDelete: Cascade)
  activatedAt  DateTime   @default(now())

  @@id([userId, metaPromptId])
}

// ─── Alertes système ─────────────────────────────────────────────────────────

model SystemAlert {
  id        String   @id @default(cuid())
  type      String
  message   String
  metadata  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Espaces documentaires ────────────────────────────────────────────────────

model DocumentSpace {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  description      String?
  icon             String           @default("📁")
  ownerId          String
  owner            User             @relation("OwnedSpaces", fields: [ownerId], references: [id], onDelete: Cascade)
  difyDatasetId    String?
  enrichmentGroups String           @default("[]")
  folders          DocumentFolder[]
  documents        SpaceDocument[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model DocumentFolder {
  id          String           @id @default(cuid())
  name        String
  slug        String
  description String?
  spaceId     String
  space       DocumentSpace    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children    DocumentFolder[] @relation("FolderTree")
  documents   SpaceDocument[]
  createdAt   DateTime         @default(now())

  @@unique([spaceId, slug])
}

model SpaceDocument {
  id           String          @id @default(cuid())
  name         String
  displayName  String?
  description  String?
  folderId     String?
  folder       DocumentFolder? @relation(fields: [folderId], references: [id])
  spaceId      String
  space        DocumentSpace   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  difyFileId   String
  uploadedById String
  uploadedBy   User            @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  uploadedAt   DateTime        @default(now())
  size         Int?
  mimeType     String?
}
