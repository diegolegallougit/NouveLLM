# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3001"

# Base de données
DATABASE_URL="postgresql://user:password@localhost:5433/nouvellm"

# Dify — instance auto-hébergée
DIFY_BASE_URL="http://localhost:5001"
DIFY_IIIAAS_API_KEY="app-your-iiiaas-api-key"
DIFY_DATASET_API_KEY="your-dify-dataset-api-key"
DIFY_COURS_ACTIFS_DATASET_ID="your-fallback-kb-dataset-id"

# LLM Provider (compatible OpenAI API)
LLM_PROVIDER_URL="https://api.your-llm-provider.com/v1"
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="your-model-name"

# Sources académiques (optionnel)
SEMANTIC_SCHOLAR_API_KEY="your-semantic-scholar-key"

# Proxy académique (optionnel — HAL + OpenAlex)
ACADEMIC_PROXY_URL="http://localhost:5050"

# Reranker TEI (optionnel)
RERANKER_URL="http://localhost:8082/rerank"
IONOS_RERANKER_URL="https://openai.inference.de-txl.ionos.com/v1"
IONOS_API_KEY="your-ionos-api-key"

# Redis (pour BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
