# Authentication
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=file:./prisma/nouvellm.db

# Dify API
DIFY_BASE_URL=http://your-dify-host:5001
DIFY_IIIAAS_API_KEY=app-xxxxxxxx
DIFY_AITUDIANT_API_KEY=app-xxxxxxxx
DIFY_DATASET_API_KEY=dataset-xxxxxxxx

# Dify webhook secret (for /api/admin/webhook/dify) — REQUIRED, route closed if unset
DIFY_WEBHOOK_SECRET=your_webhook_secret_here

# Dify web console URL (admin links to datasets/workflows pages)
NEXT_PUBLIC_DIFY_WEB_URL=http://your-dify-host:8090

# ProConnect (DINUM OIDC — optionnel, activer après configuration DSI)
# PROCONNECT_CLIENT_ID=
# PROCONNECT_CLIENT_SECRET=

# Connector token encryption (generate: openssl rand -hex 32)
CONNECTOR_ENCRYPTION_KEY=your_64_char_hex_key_here

# Admin notifications (signalements /apropos → SystemAlert + email optionnel)
ADMIN_EMAIL=admin@univ-paris3.fr

# Google Drive OAuth (console.cloud.google.com → Credentials → OAuth 2.0)
# Authorized redirect URI: https://your-host/api/connectors/gdrive/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# KB cours-actifs — créer dans Dify et noter l'ID
DIFY_COURS_ACTIFS_DATASET_ID=your_dataset_id_here

# OCR PDFs scannés via Pixtral 2409 sur Cortecs (optionnel)
CORTECS_BASE_URL=https://api.cortecs.ai/v1
CORTECS_API_KEY=

# Moodle sync (npm run moodle:sync)
# MOODLE_URL=https://moodle.sorbonne-nouvelle.fr
# MOODLE_TOKEN=your_moodle_webservice_token
# MOODLE_COURSE_ID=12345
# NOUVELLM_GROUP_SLUG=m2-trad-2026
