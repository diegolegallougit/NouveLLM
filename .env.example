# Authentication
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=file:./prisma/nouvellm.db

# Dify API
DIFY_BASE_URL=http://your-dify-host:5001
DIFY_IIIAAS_API_KEY=app-xxxxxxxx
DIFY_AITUDIANT_API_KEY=app-xxxxxxxx
DIFY_DATASET_API_KEY=dataset-xxxxxxxx

# Dify webhook secret (for /api/admin/webhook/dify)
DIFY_WEBHOOK_SECRET=your_webhook_secret_here

# ProConnect (DINUM OIDC — optionnel, activer après configuration DSI)
# PROCONNECT_CLIENT_ID=
# PROCONNECT_CLIENT_SECRET=

# Moodle sync (npm run moodle:sync)
# MOODLE_URL=https://moodle.sorbonne-nouvelle.fr
# MOODLE_TOKEN=your_moodle_webservice_token
# MOODLE_COURSE_ID=12345
# NOUVELLM_GROUP_SLUG=m2-trad-2026
