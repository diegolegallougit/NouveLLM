{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/responsable/layout,_N_T_/responsable/page,_N_T_/responsable"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/responsable/__PAGE__",
    "/responsable",
    "/_index",
    "/_head"
  ]
}